{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/appointments/:path", "destination": "/api/appointments/:path.ts" },
    { "source": "/api/(.*)", "destination": "/api/$1.ts" }
  ]
}